Include ~/.ssh/hosts/*

# GitHub uses the agent-git key (modules/common/programs/agent-git.nix) whenever it is
# loaded, so pushes work while 1Password is locked and from any session or app.
# Matched first because the first IdentityAgent wins.
Match host github.com exec "SSH_AUTH_SOCK=%d/.ssh/agent-git.sock ssh-add -l >/dev/null 2>&1"
	IdentityAgent %d/.ssh/agent-git.sock

# Use the local 1Password agent unless SSH_AUTH_SOCK already offers keys
# (e.g. a forwarded agent). IdentityAgent overrides SSH_AUTH_SOCK, so it must
# be skipped on remotes. Local herdr panes expose an empty launchd agent, so
# check for identities instead of matching the socket path.
Match exec "! ssh-add -l >/dev/null 2>&1"
	IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

Host *.home.clb.ai
	ForwardAgent yes
