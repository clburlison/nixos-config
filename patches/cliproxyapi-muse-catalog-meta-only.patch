+// museCodeProvider is the registry provider of Meta credentials, the only
+// models the Muse Code CLI is shown.
+const museCodeProvider = "meta"
+
+// MetaOnlyModelInputs keeps the models a Meta credential serves, described by
+// their Meta routes alone. A model's top-level fields can come from another
+// provider's registration, so they are dropped and buildModelEntry resolves
+// every field from the Meta routes.
+func MetaOnlyModelInputs(inputs []ModelInput) []ModelInput {
+	kept := make([]ModelInput, 0, len(inputs))
+	for _, input := range inputs {
+		var routes []ModelRoute
+		for _, route := range input.Routes {
+			if normalizeProviderName(route.Provider) == museCodeProvider {
+				routes = append(routes, route)
+			}
+		}
+		if len(routes) == 0 {
+			continue
+		}
+		kept = append(kept, ModelInput{ID: input.ID, Routes: routes})
+	}
+	return kept
+}
