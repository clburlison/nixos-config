+func TestMetaOnlyModelInputsKeepsMetaRoutes(t *testing.T) {
+	inputs := []ModelInput{
+		{ID: "muse-wonder-1.0", Routes: []ModelRoute{{Provider: "meta", ContextLength: 1000}}},
+		{ID: "gpt-6.1-sol", Routes: []ModelRoute{{Provider: "codex", ContextLength: 500}}},
+		{ID: "no-routes"},
+		{ID: "shared", DisplayName: "Codex Shared", Description: "from codex", Created: 42, Routes: []ModelRoute{
+			{Provider: "codex", ContextLength: 100, DisplayName: "Codex Shared"},
+			{Provider: " Meta ", ContextLength: 900},
+		}},
+	}
+
+	got := MetaOnlyModelInputs(inputs)
+
+	if len(got) != 2 || got[0].ID != "muse-wonder-1.0" || got[1].ID != "shared" {
+		t.Fatalf("MetaOnlyModelInputs IDs = %+v, want muse-wonder-1.0 and shared", got)
+	}
+	if len(got[1].Routes) != 1 || got[1].Routes[0].ContextLength != 900 {
+		t.Fatalf("shared routes = %+v, want only the Meta route", got[1].Routes)
+	}
+	if len(inputs[3].Routes) != 2 {
+		t.Fatalf("MetaOnlyModelInputs changed its input's routes: %+v", inputs[3].Routes)
+	}
+	if got[1].DisplayName != "" || got[1].Description != "" || got[1].Created != 0 {
+		t.Fatalf("shared kept another provider's top-level fields: %+v", got[1])
+	}
+	entries := BuildModelsResponse(got).Data
+	if len(entries) != 2 || entries[1].Metadata.MuseCode.Limit == nil || entries[1].Metadata.MuseCode.Limit.Context != 900 {
+		t.Fatalf("shared catalog entry = %+v, want Meta's 900 context", entries)
+	}
+	if raw, _ := MarshalCompact(Response{Object: "list", Data: entries[1:]}); strings.Contains(string(raw), "Codex Shared") || strings.Contains(string(raw), "from codex") {
+		t.Fatalf("shared catalog entry leaked codex metadata: %s", raw)
+	}
+}
